@page "/{region:region}/{**path}"
@model ShowModel
@{
    var text = Site.Text;
}
@section Head {
    <title>@Model.Title · @text["siteName"]</title>
    <link rel="canonical" href="@Model.Seo.Canonical" />
    @if (Model.Seo.Description is { } seoDescription)
    {
        <meta name="description" content="@seoDescription" />
    }
    @if (Model.Seo.Robots is { } robots)
    {
        <meta name="robots" content="@robots" />
    }
    @foreach (var (hreflang, href) in Model.Seo.Alternates)
    {
        <link rel="alternate" hreflang="@hreflang" href="@href" />
    }
    @if (Model.ProductPage?.Product.Image is { } hero)
    {
        @* The product picture is the largest thing above the fold: the browser fetches it before it has laid out the page.
           The preload only helps if its `imagesizes` equals the `sizes` of the product's <img> in _ProductPage.cshtml: change both together. *@
        var srcset = Images.SrcSet(hero); // none for SVG: then the file itself
        <link rel="preload" as="image" href="@(srcset is null ? hero : null)" imagesrcset="@srcset" imagesizes="@(srcset is null ? null : "(min-width: 760px) 55vw, 100vw")" />
    }
}
<partial name="_Crumbs" model="Model.Crumbs" />
@if (Model.ProductPage is { } product)
{
    <partial name="_ProductPage" model="product" />
}
else
{
    <partial name="_Content" model="Model.Document" />
}
