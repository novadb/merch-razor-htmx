@page "/{region:region}/search"
@model SearchModel
@{
    var text = Site.Text;
}
@section Head {
    @* No canonical or hreflang: internal search results are not meant to be indexed. *@
    <title>@text["search"] · @text["siteName"]</title>
}
<section class="merchHero merchHero--compact">
    <p class="merchKicker">@text["search"]</p>
    <h1 class="merchDisplay">@text.SearchTitle(Model.Query)</h1>
    <partial name="_SearchBox" model='new SearchBoxView("suggest-2", true, Model.Query)' />
    @if (Model.Pages.Count > 0)
    {
        <nav class="search-pages" aria-label="@text["pagesFound"]">
            <span>@text["pagesFound"]:</span>
            @foreach (var p in Model.Pages)
            {
                <a href="@p.Url">@p.Title</a>
            }
        </nav>
    }
</section>
<partial name="_Range" model="Model.Range" />
