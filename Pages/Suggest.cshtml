@page "/api/suggest"
@model SuggestModel
@{
    Layout = null;
    var n = 0;
}
<ul id="@Model.ListId" class="suggest" role="listbox" hidden="@(Model.Query is null)">
    @if (Model.Query is { } query)
    {
        if (Model.Products.Count > 0)
        {
            <li class="suggest__heading" role="presentation">@Model.Text["products"]</li>
        }
        foreach (var p in Model.Products)
        {
            <li id="@($"{Model.ListId}-{n++}")" class="suggest__option" role="option" data-href="@p.Url">@if (p.Image is { } image) {<img src="@Images.SmallSrc(image)" alt="" width="40" height="40" />}<span class="suggest__name">@p.Name</span><span class="suggest__price">@Model.Region.FormatPrice(p.Price)</span></li>
        }
        if (Model.Pages.Count > 0)
        {
            <li class="suggest__heading" role="presentation">@Model.Text["pagesFound"]</li>
        }
        foreach (var found in Model.Pages)
        {
            <li id="@($"{Model.ListId}-{n++}")" class="suggest__option" role="option" data-href="@found.Url"><span class="suggest__name">@found.Title</span></li>
        }
        <li id="@($"{Model.ListId}-{n}")" class="suggest__option" role="option"><span class="suggest__name suggest__all">@Model.Text["searchAll"] “@query”</span></li>
    }
</ul>
