@*
    A live product range: facet filters as a POST form (the URL stays the page's), sorting and the product grid.
    Without JavaScript the form posts and the browser shows the answer. With htmx the same POST goes to the same URL in
    the background, `#range` is taken from the answer and morphed into the page: cards, focus and scroll position stay
    where they are. The morph removes `aria-busy` again: the answer does not carry it.
*@
@model (ProductRange Range, ContentContext Ctx, IReadOnlyDictionary<int, string> GroupNames, string? Query)
@{
    var (range, ctx, groupNames, query) = Model;
    var (items, facets, selection, defaultSort) = range;
    var text = ctx.Text;
    var action = Context.Request.Path;
    var sortLabel = new Dictionary<string, string>
    {
        ["relevance"] = text["sortRelevance"], ["name"] = text["sortName"], ["price-asc"] = text["sortPriceAsc"], ["price-desc"] = text["sortPriceDesc"],
    };
    // "relevance" is offered only where it is the default: a search with usable terms.
    var sorts = Catalog.Sorts.Where(s => s != "relevance" || defaultSort == "relevance");
    var currentSort = selection.Sort ?? defaultSort;

    void FacetGroup(string legend, string name, IEnumerable<FacetValue> values, Func<string, string> labelOf, Func<string, string?>? swatchOf = null)
    {
        var list = values.ToList();
        if (list.Count == 0) return;
        <fieldset class="facet">
            <legend>@legend</legend>
            @foreach (var v in list)
            {
                // No hit with the other filters: stays listed (the list never changes), but cannot be chosen.
                <label class="facet__option"><input type="checkbox" name="@name" value="@v.Value" checked="@v.Selected" disabled="@(v.Count == 0 && !v.Selected)" />@if (swatchOf is not null) {<span class="swatch" style="--swatch:@swatchOf(v.Value)" aria-hidden="true"></span>}<span>@labelOf(v.Value)</span><span class="facet__count">@v.Count</span></label>
            }
        </fieldset>
    }
}
@functions {
    // The scroll position stays. Only when it cannot (the page got shorter than it) or shows no result any more (the
    // range ends above the window) the range is shown from its start, below the sticky header (its scroll-margin-top).
    const string ShowStart = "if (Math.abs(scrollY - this.scrolled) > 1 || this.lastElementChild.getBoundingClientRect().bottom < parseFloat(getComputedStyle(this).scrollMarginTop)) this.scrollIntoView({ behavior: 'instant' })";
}
<section class="range" id="range" aria-label="@text["filter"]"
         hx-select:inherited="#range" hx-target:inherited="#range" hx-swap:inherited="outerMorph"
         hx-on::before:request="this.ariaBusy = true" hx-on::before:swap="this.scrolled = scrollY" hx-on::after:swap="@ShowStart">
    <form class="facets" id="facets" method="post" action="#range"
          hx-post="@action" hx-trigger="submit, change[target.type !== 'number'] from:#range">
        @if (query is { Length: > 0 })
        {
            <input type="hidden" name="q" value="@query" />
        }
        @if (facets.Group.Count > 1)
        {
            FacetGroup(text["group"], "group", facets.Group.Where(v => groupNames.ContainsKey(int.Parse(v.Value))), v => groupNames[int.Parse(v)]);
        }
        @{ FacetGroup(text["colour"], "color", facets.Color, v => text.Value(int.Parse(v)), v => text.Swatch(int.Parse(v))); }
        @{ FacetGroup(text["material"], "material", facets.Material, v => text.Value(int.Parse(v))); }
        <fieldset class="facet">
            <legend>@text["availability"]</legend>
            <label class="facet__option"><input type="checkbox" name="stock" value="1" checked="@selection.Stock" /><span>@text["inStock"]</span><span class="facet__count">@facets.InStock</span></label>
        </fieldset>
        <fieldset class="facet facet--price">
            <legend>@text["price"]</legend>
            <label><span>@text["from"]</span><input type="number" name="min" inputmode="numeric" min="0" placeholder="@facets.PriceMin" value="@selection.Min" /></label>
            <label><span>@text["to"]</span><input type="number" name="max" inputmode="numeric" min="0" placeholder="@facets.PriceMax" value="@selection.Max" /></label>
        </fieldset>
        <div class="facets__actions">
            <button type="submit" class="button">@text["apply"]</button>
            @* A morph keeps what the visitor ticked: the reset replaces the range instead. *@
            <button type="submit" name="reset" value="1" class="button button--ghost" hx-post="@action" hx-vals="reset:1" hx-swap="outerHTML">@text["reset"]</button>
        </div>
    </form>
    <div class="range__main">
        <div class="range__bar">
            <p class="range__count" aria-live="polite">@text.Results(items.Count)</p>
            <label class="range__sort">
                <span>@text["sort"]</span>
                <select name="sort" form="facets">
                    @foreach (var s in sorts)
                    {
                        <option value="@s" selected="@(s == currentSort)">@sortLabel[s]</option>
                    }
                </select>
            </label>
        </div>
        @if (items.Count > 0)
        {
            <div class="grid">
                @foreach (var p in items.Take(selection.Shown))
                {
                    @await Html.PartialAsync("_ProductCard", (p, ctx, (string?)$"card-{p.Id}"))
                }
            </div>
        }
        else
        {
            <p class="range__empty">@text["noResults"]</p>
        }
        @* Posts the filters again with one batch more. A click submits the form; htmx also sends it by itself when the button comes near the window. *@
        @if (items.Count > selection.Shown)
        {
            var more = selection.Shown + Catalog.RangeBatch;
            <button type="submit" form="facets" name="shown" value="@more" class="button button--ghost range__more"
                    hx-post="@action" hx-trigger="intersect rootMargin:600px" hx-vals="shown:@more">@text["showMore"]</button>
        }
    </div>
</section>
