@*
    A live product range: facet filters as a GET form (its fields are the address's query string), sorting and the product grid.
    Without JavaScript the form submits and the browser shows the answer. With htmx the same GET goes out in the background,
    the page answers with `#range` alone, it is morphed into the page and the address follows: cards, focus and scroll
    position stay where they are. The morph removes `aria-busy` again: the answer does not carry it.
*@
@model RangeView
@{
    var (range, groupNames, query) = Model;
    var (items, facets, selection, _) = range;
    var text = Site.Text;
    var action = Context.Request.Path;
    var sortLabel = new Dictionary<string, string>
    {
        ["relevance"] = text["sortRelevance"], ["name"] = text["sortName"], ["price-asc"] = text["sortPriceAsc"], ["price-desc"] = text["sortPriceDesc"],
    };
    // "relevance" is offered only where it is the default: a search with usable terms.
    var sorts = Catalog.Sorts.Where(s => s != "relevance" || range.DefaultSort == "relevance");
    var currentSort = selection.Sort ?? range.DefaultSort;
    ViewData["CardIds"] = true; // the cards of a range are told apart by ID (_ProductCard)

    void FacetGroup(string legend, string name, IEnumerable<FacetValue> values, Func<string, string> labelOf, Func<string, string?>? swatchOf = null)
    {
        var list = values.ToList();
        if (list.Count == 0) return;
        <fieldset class="facet">
            <legend>@legend</legend>
            @foreach (var v in list)
            {
                // No hit with the other filters: stays listed (the list never changes), but cannot be chosen.
                <label class="facet__option"><input type="checkbox" name="@name" value="@v.Value" checked="@v.Selected" disabled="@(v.Count == 0 && !v.Selected)" />@if (swatchOf is not null) {<span class="swatch" style="--swatch:@swatchOf(v.Value)" aria-hidden="true"></span>}<span>@labelOf(v.Value)</span><span class="facet__count">@v.Count</span></label>
            }
        </fieldset>
    }
}
@functions {
    // htmx 4 on the section below: `:inherited` passes an attribute on to the elements inside (otherwise it applies to
    // its own element only), `outerMorph` swaps by morphing (focus, scroll and what is ticked stay), and
    // `hx-on::before:request` is the event `htmx:before:request`.
    // The form's trigger `from:#range` also catches the sort <select>, which stands outside the form (`form="facets"`)
    // but inside the range; number inputs are left out, so a price applies on Enter or "Apply", not per keystroke.
    // `hx-push-url` puts the form's fields in the address: a filtered view can be shared, and Back returns to the one before.
}
<section class="range" id="range" aria-label="@text["filter"]"
         hx-target:inherited="#range" hx-swap:inherited="outerMorph" hx-on::before:request="this.ariaBusy = true">
    <form class="facets" id="facets" method="get" action="#range"
          hx-get="@action" hx-push-url="true" hx-trigger="submit, change[target.type !== 'number'] from:#range">
        @if (query is { Length: > 0 })
        {
            <input type="hidden" name="q" value="@query" />
        }
        @if (facets.Group.Count > 1)
        {
            FacetGroup(text["group"], "group", facets.Group.Where(v => groupNames.ContainsKey(int.Parse(v.Value))), v => groupNames[int.Parse(v)]);
        }
        @{ FacetGroup(text["colour"], "color", facets.Color, v => text.Value(int.Parse(v)), v => text.Swatch(int.Parse(v))); }
        @{ FacetGroup(text["material"], "material", facets.Material, v => text.Value(int.Parse(v))); }
        <fieldset class="facet">
            <legend>@text["availability"]</legend>
            <label class="facet__option"><input type="checkbox" name="stock" value="1" checked="@selection.Stock" /><span>@text["inStock"]</span><span class="facet__count">@facets.InStock</span></label>
        </fieldset>
        <fieldset class="facet facet--price">
            <legend>@text["price"]</legend>
            <label><span>@text["from"]</span><input type="number" name="min" inputmode="numeric" min="0" placeholder="@facets.PriceMin" value="@selection.Min" /></label>
            <label><span>@text["to"]</span><input type="number" name="max" inputmode="numeric" min="0" placeholder="@facets.PriceMax" value="@selection.Max" /></label>
        </fieldset>
        <div class="facets__actions">
            <button type="submit" class="button">@text["apply"]</button>
            @* A morph keeps what the visitor ticked: the reset replaces the range instead, and carries only the search query. *@
            <button type="submit" name="reset" value="1" class="button button--ghost"
                    hx-get="@action" hx-push-url="true" hx-vals='{"reset":1}' hx-include="@(query is { Length: > 0 } ? "#facets [name=q]" : null)" hx-swap="outerHTML">@text["reset"]</button>
        </div>
    </form>
    <div class="range__main">
        <div class="range__bar">
            <p class="range__count" aria-live="polite">@text.Results(items.Count)</p>
            <label class="range__sort">
                <span>@text["sort"]</span>
                <select name="sort" form="facets">
                    @foreach (var s in sorts)
                    {
                        <option value="@s" selected="@(s == currentSort)">@sortLabel[s]</option>
                    }
                </select>
            </label>
        </div>
        @if (items.Count > 0)
        {
            <div class="grid">
                @foreach (var p in items.Take(selection.Shown))
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        }
        else
        {
            <p class="range__empty">@text["noResults"]</p>
        }
        <partial name="_ShowMore" model="Model" />
    </div>
</section>
