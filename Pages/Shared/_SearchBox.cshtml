@*
    The search form with its typeahead (an ARIA combobox). The search itself is a plain GET of /{region}/search.
    While typing, htmx asks the search page for its list (`handler=suggest`, Pages/Search.cshtml.cs) and puts it in place
    of the empty one. The keys of the combobox (arrows, Enter, Escape) and a pick with the mouse are in ui.js.
*@
@model SearchBoxView
@{
    var (listId, large, query) = Model;
    var region = Site.Region;
    var text = Site.Text;
}
<form class="@(large ? "search search--large" : "search")" role="search" method="get" action="/@region.Code/search">
    <input type="search" name="q" value="@query" placeholder="@text["searchPlaceholder"]" aria-label="@text["search"]" autocomplete="off"
           role="combobox" aria-controls="@listId" aria-autocomplete="list" aria-expanded="false"
           hx-get="/@region.Code/search" hx-vals='{"handler":"suggest","list":"@listId"}' hx-trigger="input changed delay:150ms" hx-target="#@listId" hx-swap="outerHTML"
           hx-on::after:swap="this.ariaExpanded = !document.getElementById('@listId').hidden" />
    <ul id="@listId" class="suggest" role="listbox" hidden></ul>
    @if (large)
    {
        <button type="submit" class="button">@text["search"]</button>
    }
</form>
