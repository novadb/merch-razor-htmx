@* The breadcrumb of a page or product: the trail from the home page, the last item being the page itself. The home page has none. *@
@model IReadOnlyList<Target>
@if (Model.Count >= 2)
{
    <nav class="crumbs" aria-label="@Site.Text["breadcrumb"]">
        <ol>
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                if (i == Model.Count - 1)
                {
                    <li><span aria-current="page">@item.Title</span></li>
                }
                else
                {
                    <li><a href="@item.Url">@item.Title</a></li>
                }
            }
        </ol>
    </nav>
}
