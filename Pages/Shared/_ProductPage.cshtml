@* A product's page: the article with its picture, price, shop button and specs, then the rows of related products. *@
@model ProductView
@{
    var (p, groupName, contents, similar, accessories, spareParts) = Model;
    var text = Site.Text;
    var deliveryDays = p.Articles.Where(a => a.Stock > 0).Select(a => a.DeliveryDays).Min();
    var specs = new (string Name, string Value)[]
    {
        (text["sku"], string.Join(", ", p.Articles.Select(a => a.Sku).OfType<string>())),
        (text["colour"], string.Join(", ", p.Colors.Select(text.Value))),
        (text["material"], string.Join(", ", p.Materials.Select(text.Value))),
        (text["volume"], p.Volume is { } volume ? $"{volume} ml" : ""),
        (text["screenSize"], p.ScreenSize is { } inches ? $"{inches}″" : ""),
        (text["finish"], string.Join(", ", p.Finishes.Select(text.Value))),
        (text["pieces"], p.Pieces is { } pieces ? text.PieceCount(pieces) : ""),
        (text["delivery"], deliveryDays?.ToString() ?? ""),
    };
    var bands = new (string Title, List<Product> Products)[]
    {
        (text["similar"], similar), (text["accessories"], accessories), (text["spareParts"], spareParts),
    };
}
<article class="pdp">
    <div class="pdp__media">
        @if (p.Image is { } src)
        {
            <img src="@src" srcset="@Images.SrcSet(src)" sizes="(min-width: 760px) 55vw, 100vw" alt="@p.Name" width="400" height="400" />
        }
    </div>
    <div class="pdp__info">
        @if (groupName is not null)
        {
            <p class="merchKicker">@groupName</p>
        }
        <h1 class="pdp__name">@p.Name</h1>
        <p class="pdp__price">@Site.Region.FormatPrice(p.Price)<span class="@(p.InStock == false ? "badge badge--muted" : "badge")">@(p.InStock == false ? text["soldOut"] : text["available"])</span></p>
        @if (p.ShopifyId is not null && p.InStock != false)
        {
            <div class="pdp__buy" data-shopify-product="@p.ShopifyId"></div>
        }
        @if (p.DescriptionHtml is { } description)
        {
            <div class="pdp__description">@Html.Raw(description)</div>
        }
        <dl class="specs">
            @foreach (var (name, value) in specs.Where(s => s.Value.Length > 0))
            {
                <div><dt>@name</dt><dd>@value</dd></div>
            }
        </dl>
        @if (contents.Count > 0)
        {
            <h2 class="pdp__subhead">@text["setContents"]</h2>
            <ul class="pdp__list">
                @foreach (var row in contents)
                {
                    <li>@row.Quantity × @if (row.Url is { } url) {<a href="@url">@row.Name</a>} else {@row.Name}</li>
                }
            </ul>
        }
        @if (p.Claims.Length > 0)
        {
            <h2 class="pdp__subhead">@text["claims"]</h2>
            <ul class="pdp__list">
                @foreach (var claim in p.Claims)
                {
                    <li>@claim</li>
                }
            </ul>
        }
    </div>
</article>
@foreach (var (title, products) in bands.Where(b => b.Products.Count > 0))
{
    <section class="merchBand">
        <h2 class="headline">@title</h2>
        <div class="grid">
            @foreach (var s in products)
            {
                <partial name="_ProductCard" model="s" />
            }
        </div>
    </section>
}
